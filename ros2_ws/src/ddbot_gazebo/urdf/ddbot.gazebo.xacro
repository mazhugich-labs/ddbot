<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
        </plugin>
    </gazebo>

    <!-- DDBOT Gazebo Controllers -->
    <xacro:include filename="$(find ddbot_gazebo)/urdf/ddbot_control.gazebo.xacro" />

    <!-- DDBOT Gazebo Sensors -->
    <xacro:include filename="$(find ddbot_gazebo)/urdf/ddbot_sensor.gazebo.xacro" />

</robot>