<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="ground_truth_odom" default="false" />

    <!-- Skid Drive -->
    <gazebo>
        <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
            <left_joint>wheel_fl_joint</left_joint>
            <right_joint>wheel_fr_joint</right_joint>

            <left_joint>wheel_rl_joint</left_joint>
            <right_joint>wheel_rr_joint</right_joint>

            <wheel_separation>${base_w+wheel_l}</wheel_separation>

            <wheel_radius>${wheel_r}</wheel_radius>

            <odom_publish_frequency>50</odom_publish_frequency>

            <topic>/cmd_vel</topic>

            <xacro:unless value="$(arg ground_truth_odom)">
                <odom_topic>/wheel/odom</odom_topic>
                <tf_topic>/wheel/tf</tf_topic>
            </xacro:unless>

            <max_wheel_torque>5</max_wheel_torque>
            <max_wheel_acceleration>2.5</max_wheel_acceleration>

            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
        </plugin>
    </gazebo>

    <xacro:if value="$(arg ground_truth_odom)">
        <gazebo>
            <plugin filename="libignition-gazebo6-odometry-publisher-system"
                name="ignition::gazebo::systems::OdometryPublisher">
                <odom_frame>odom</odom_frame>
                <robot_base_frame>base_footprint</robot_base_frame>
                <odom_topic>/odom</odom_topic>
                <tf_topic>/tf</tf_topic>
                <dimensions>2</dimensions>
                <odom_publish_frequency>10</odom_publish_frequency>
            </plugin>
        </gazebo>
    </xacro:if>

</robot>